---
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import Section from '../components/Section.astro';
import Project from '../components/Project.astro';
import Clock from '../components/Clock.astro';
import portrait from '../assets/portrait.jpg';
import {
  profile,
  about,
  numbers,
  projects,
  openSource,
  experience,
  principles,
  skills,
} from '../data/site';

const posts = (await getCollection('writing')).sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
const published = posts.filter((p) => !p.data.draft);
const drafts = posts.filter((p) => p.data.draft);
const writingTeaser = published.length
  ? `${published.length} note${published.length > 1 ? 's' : ''}`
  : `${drafts.length} in draft`;

const fmtDate = (d: Date) => d.toLocaleDateString('en-US', { month: 'short', year: 'numeric' });
---

<Base>
  <header class="frame intro">
    <div class="margin"></div>
    <div>
      <div class="top reveal" style="--i: 0">
        <Image src={portrait} alt="Portrait of Bijay Subedi" width={128} height={128} class="portrait" loading="eager" />
        <p class="status mono">
          <Clock /><br />
          <span class="muted">{profile.availability}</span>
        </p>
      </div>

      <h1 class="reveal" style="--i: 1">{profile.name}</h1>
      <p class="role label reveal" style="--i: 2">{profile.role} · {profile.location}</p>
      <p class="statement reveal" style="--i: 3">{profile.statement}</p>

      <nav class="actions mono reveal" style="--i: 4" aria-label="Quick links">
        <a href="#work">Selected work</a>
        <a href={profile.resume}>Résumé (PDF)</a>
        <button type="button" class="copy" data-email={profile.email}>
          <span data-label>Copy email</span>
        </button>
        {profile.links.map((l) => <a href={l.href} rel="me">{l.label}</a>)}
      </nav>
    </div>
  </header>

  <main>
    <Section id="about" n={1} title="About" teaser="5+ years · Rails, React, AWS" open i={5}>
      {about.map((p) => <p>{p}</p>)}
      <ul class="numbers">
        {
          numbers.map((x) => (
            <li>
              <span class="value">{x.value}</span>
              <span class="mono muted">{x.label}</span>
            </li>
          ))
        }
      </ul>
    </Section>

    <Section id="work" n={2} title="Selected work" teaser={`${projects.length} case studies`} open i={6}>
      <p class="lede muted">Each one in a sentence. Open any of them for the problem, the decisions, and what changed.</p>
      {projects.map((p, i) => <Project project={p} index={i} />)}
    </Section>

    <Section id="principles" n={3} title="How I work" teaser={`${principles.length} principles`} i={7}>
      <p class="lede muted">Rules I keep coming back to — each one learned on a project above.</p>
      <ol class="principles">
        {
          principles.map((p) => (
            <li>
              <strong>{p.title}</strong> {p.body}
              <span class="from label">{p.from}</span>
            </li>
          ))
        }
      </ol>
    </Section>

    <Section id="experience" n={4} title="Experience" teaser="Truemark · 2021 — now" i={8}>
      {
        experience.map((job) => (
          <article class="job">
            <header>
              <h3>
                {job.title}, <a href={job.href}>{job.company}</a>
              </h3>
              <span class="label">{job.period}</span>
            </header>
            <p class="muted">{job.summary}</p>
            <ul class="dash">
              {job.points.map((pt) => (
                <li>{pt}</li>
              ))}
            </ul>
          </article>
        ))
      }
    </Section>

    <Section id="open-source" n={5} title="Open source" teaser="Built in public" i={9}>
      {
        openSource.map((o) => (
          <article class="oss">
            <h3>
              <a href={o.href}>{o.name}</a> <span class="label">↗ GitHub</span>
            </h3>
            <p>{o.summary}</p>
            <ul class="dash">
              {o.notes.map((n) => (
                <li>{n}</li>
              ))}
            </ul>
            <p class="mono muted stack">{o.stack.join(' · ')}</p>
          </article>
        ))
      }
    </Section>

    <Section id="writing" n={6} title="Writing" teaser={writingTeaser} i={10}>
      {
        published.length > 0 && (
          <ul class="posts">
            {published.map((p) => (
              <li>
                <a href={`/writing/${p.id}/`}>{p.data.title}</a>
                <span class="label">{fmtDate(p.data.date)}</span>
              </li>
            ))}
          </ul>
        )
      }
      {
        drafts.length > 0 && (
          <>
            <p class="lede muted">On the desk — notes from real projects, not yet finished:</p>
            <ul class="posts drafts">
              {drafts.map((p) => (
                <li>
                  <span>{p.data.title}</span>
                  <span class="label">Draft</span>
                </li>
              ))}
            </ul>
          </>
        )
      }
    </Section>

    <Section id="skills" n={7} title="Toolkit" teaser="What I reach for" i={11}>
      <dl class="skills">
        {
          skills.map((s) => (
            <div>
              <dt class="label">{s.group}</dt>
              <dd>{s.items.join(', ')}</dd>
            </div>
          ))
        }
      </dl>
    </Section>

    <section class="frame contact reveal" style="--i: 11" aria-labelledby="contact-title">
      <div class="margin label" aria-hidden="true">§ —</div>
      <div>
        <h2 id="contact-title">Have a process held together by spreadsheets?</h2>
        <p>
          I’d like to hear about it. Write to <a href={`mailto:${profile.email}`}>{profile.email}</a>.
        </p>
        <p class="mono muted">{profile.utcOffset} · overlap {profile.overlap}</p>
      </div>
    </section>
  </main>
</Base>

<script>
  document.querySelectorAll<HTMLButtonElement>('button.copy').forEach((btn) => {
    const label = btn.querySelector<HTMLElement>('[data-label]')!;
    btn.addEventListener('click', async () => {
      const email = btn.dataset.email!;
      try {
        await navigator.clipboard.writeText(email);
        label.textContent = 'Copied ✓';
      } catch {
        location.href = `mailto:${email}`;
        return;
      }
      setTimeout(() => (label.textContent = 'Copy email'), 1800);
    });
  });
</script>

<style>
  .intro {
    margin-bottom: 3.5rem;
  }
  .top {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: 1rem;
    margin-bottom: 1.75rem;
  }
  .portrait {
    width: 64px;
    height: 64px;
    border-radius: 50%;
    object-fit: cover;
    filter: saturate(0.85) sepia(0.08);
  }
  .status {
    margin: 0;
    text-align: right;
  }
  h1 {
    margin: 0;
    font-size: clamp(2.5rem, 7vw, 3.5rem);
    line-height: 1;
    font-weight: 400;
    letter-spacing: -0.025em;
  }
  .role {
    margin: 0.85rem 0 1.25rem;
  }
  .statement {
    font-size: 1.375rem;
    line-height: 1.45;
    max-width: 34rem;
    margin-bottom: 1.5rem;
  }
  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1.25rem;
  }
  .actions a,
  .copy {
    color: var(--ink);
  }
  .copy {
    font: inherit;
    background: none;
    border: 0;
    padding: 0;
    cursor: pointer;
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-decoration-color: var(--rule);
    text-underline-offset: 0.2em;
  }
  .copy:hover {
    text-decoration-color: var(--accent);
  }

  .lede {
    font-style: italic;
    margin-bottom: 0.5rem;
  }

  .numbers {
    list-style: none;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1.25rem 1.5rem;
    margin-top: 1.75rem;
    padding-top: 1.25rem;
    border-top: 1px dashed var(--rule);
  }
  .numbers li {
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
  }
  .value {
    font-size: 1.75rem;
    line-height: 1.1;
    font-weight: 400;
    font-variant-numeric: lining-nums;
  }

  .principles {
    list-style: none;
    counter-reset: p;
  }
  .principles li {
    counter-increment: p;
    position: relative;
    padding: 0.85rem 0 0.85rem 2rem;
    border-bottom: 1px dashed var(--rule);
  }
  .principles li:last-child {
    border-bottom: 0;
  }
  .principles li::before {
    content: counter(p, lower-roman) '.';
    position: absolute;
    left: 0;
    top: 1.05rem;
    font-family: var(--mono);
    font-size: 0.7rem;
    color: var(--accent);
  }
  .principles strong {
    font-weight: 500;
    font-style: italic;
  }
  .from {
    display: block;
    margin-top: 0.25rem;
  }

  h3 {
    margin: 0;
    font-size: 1.2rem;
    font-weight: 500;
  }
  .job + .job {
    margin-top: 2rem;
  }
  .job header {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    flex-wrap: wrap;
    gap: 0.25rem 1rem;
  }
  .job header + p {
    margin: 0.3rem 0 0.75rem;
    font-style: italic;
  }
  .dash {
    list-style: none;
  }
  .dash li {
    position: relative;
    padding-left: 1.1rem;
  }
  .dash li + li {
    margin-top: 0.3rem;
  }
  .dash li::before {
    content: '–';
    position: absolute;
    left: 0;
    color: var(--muted);
  }
  .oss h3 {
    margin-bottom: 0.5rem;
  }
  .oss h3 .label {
    margin-left: 0.4rem;
  }
  .stack {
    margin: 1rem 0 0;
  }

  .posts {
    list-style: none;
  }
  .posts li {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 1rem;
    padding: 0.6rem 0;
    border-bottom: 1px dashed var(--rule);
  }
  .drafts li {
    color: var(--muted);
  }

  .skills {
    margin: 0;
  }
  .skills div {
    display: grid;
    grid-template-columns: 8.5rem 1fr;
    gap: 1rem;
    padding: 0.55rem 0;
    border-bottom: 1px dashed var(--rule);
  }
  .skills div:last-child {
    border-bottom: 0;
  }
  .skills dt {
    padding-top: 0.3rem;
  }
  .skills dd {
    margin: 0;
  }

  .contact > div:last-child {
    border-top: 1px solid var(--ink);
    padding-top: 2rem;
    margin-top: 0;
  }
  .contact h2 {
    margin: 0 0 0.75rem;
    font-size: 1.75rem;
    font-weight: 400;
    font-style: italic;
    line-height: 1.2;
    letter-spacing: -0.015em;
  }
  .contact .mono {
    margin: 0;
  }

  @media (max-width: 30rem) {
    .numbers {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
    .skills div {
      grid-template-columns: 1fr;
      gap: 0.15rem;
    }
    .statement {
      font-size: 1.25rem;
    }
  }
</style>
