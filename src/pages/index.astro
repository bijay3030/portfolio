---
import { url } from '../utils/url';
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import Section from '../components/Section.astro';
import Project from '../components/Project.astro';
import Clock from '../components/Clock.astro';
import StructuredData from '../components/StructuredData.astro';
import portrait from '../assets/portrait.jpg';
import {
  profile,
  about,
  aiWorkflow,
  projects,
  openSource,
  experience,
  skills,
  education,
  testimonials,
} from '../data/site';

const posts = (await getCollection('writing')).sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
const published = posts.filter((p) => !p.data.draft);

// Unapproved testimonials appear only in dev, so the live site never shows words nobody signed off on.
const quotes = testimonials.filter((t) => t.approved || import.meta.env.DEV);
// Show the employer once when every role was at the same company.
const company = experience.every((j) => j.company === experience[0].company) ? experience[0] : null;

// Section numbers follow whatever is visible, so hiding a section never leaves a gap.
let n = 3;
const sectionNo = {
  openSource: openSource.length > 0 ? ++n : 0,
  writing: published.length > 0 ? ++n : 0,
  skills: ++n,
};

const fmtDate = (d: Date) => d.toLocaleDateString('en-US', { month: 'short', year: 'numeric' });
---

<Base>
  <StructuredData slot="head" />
  <header class="frame intro">
    <div class="margin"></div>
    <div>
      <div class="top reveal" style="--i: 0">
        <Image src={portrait} alt="Portrait of Bijay Subedi" width={128} height={128} class="portrait" loading="eager" />
        <p class="status mono">
          <Clock /><br />
          <span class="muted">{profile.availability}</span>
        </p>
      </div>

      <h1 class="reveal" style="--i: 1">{profile.name}</h1>
      <p class="role label reveal" style="--i: 2">{profile.tagline}</p>
      <p class="statement reveal" style="--i: 3">{profile.statement}</p>

      <nav class="actions mono reveal" style="--i: 4" aria-label="Quick links">
        <a href="#work">Selected work</a>
        <a href={url(profile.resume)}>Résumé (PDF)</a>
        <button type="button" class="copy" data-email={profile.email}>
          <span data-label>Copy email</span>
        </button>
        {profile.links.map((l) => <a href={l.href} rel="me">{l.label}</a>)}
      </nav>
    </div>
  </header>

  <main>
    <div class="frame toolbar">
      <div class="margin"></div>
      <div><button type="button" class="toggle-all mono" aria-controls="about work experience skills">Expand all</button></div>
    </div>
    <Section id="about" n={1} title="About" teaser="Approach" open i={5}>
      {about.map((p) => <p>{p}</p>)}
      <h3 class="workflow-title label">How I ship a feature with AI</h3>
      <ol class="workflow">
        {
          aiWorkflow.map((w) => (
            <li>
              <strong>{w.step}</strong>
              <span>{w.detail}</span>
            </li>
          ))
        }
      </ol>
    </Section>

    <Section id="work" n={2} title="Selected work" teaser={`${projects.length} case studies`} open i={6}>
      {projects.map((p, i) => <Project project={p} index={i} />)}
    </Section>

    {
      quotes.length > 0 && (
        <section class="frame quotes reveal" style="--i: 6" aria-label="What people say">
          <div class="margin label" aria-hidden="true">
            “ ”
          </div>
          <div>
            {quotes.map((t) => (
              <figure>
                {!t.approved && <span class="sample label">Pending approval — not live</span>}
                <blockquote>{t.quote}</blockquote>
                <figcaption class="mono">
                  {t.href ? <a href={t.href}>{t.name}</a> : t.name}, {t.title}
                  <span class="muted"> · {t.relationship}</span>
                </figcaption>
              </figure>
            ))}
          </div>
        </section>
      )
    }

    <Section id="experience" n={3} title="Experience" teaser={`${experience.length} roles`} open i={7}>
      {
        company && (
          <p class="employer label">
            <a href={company.href}>{company.company} ↗</a>
          </p>
        )
      }
      {
        experience.map((job) => (
          <article class="job">
            <header>
              <h3>
                {job.title}
                {!company && (
                  <>
                    , <a href={job.href}>{job.company}</a>
                  </>
                )}
              </h3>
              <span class="label">{job.period}</span>
            </header>
            <p class="muted">{job.summary}</p>
            {job.metrics.length > 0 && (
              <ul class="numbers">
                {job.metrics.map((x) => (
                  <li>
                    <span class="value">{x.value}</span>
                    <span class="mono muted">{x.label}</span>
                  </li>
                ))}
              </ul>
            )}
            <ul class="dash">
              {job.points.map((pt) => (
                <li>{pt}</li>
              ))}
            </ul>
          </article>
        ))
      }
      <div class="education">
        <span class="label">Education</span>
        {
          education.map((e) => (
            <p>
              {e.degree}, {e.school} <span class="label">{e.years}</span>
            </p>
          ))
        }
      </div>
    </Section>

    {
      openSource.length > 0 && (
    <Section id="open-source" n={sectionNo.openSource} title="Open source" teaser="Built in public" i={8}>
      {
        openSource.map((o) => (
          <article class="oss">
            <h3>
              <a href={o.href}>{o.name}</a> <span class="label">↗ GitHub</span>
            </h3>
            <p>{o.summary}</p>
            <ul class="dash">
              {o.notes.map((n) => (
                <li>{n}</li>
              ))}
            </ul>
            <p class="mono muted stack">{o.stack.join(' · ')}</p>
          </article>
        ))
      }
    </Section>
      )
    }

    {
      // Writing appears only once a post is published — unfinished drafts stay off the page.
      published.length > 0 && (
        <Section id="writing" n={sectionNo.writing} title="Writing" teaser={`${published.length} note${published.length > 1 ? 's' : ''}`} i={9}>
          <ul class="posts">
            {published.map((p) => (
              <li>
                <a href={url(`writing/${p.id}/`)}>{p.data.title}</a>
                <span class="label">{fmtDate(p.data.date)}</span>
              </li>
            ))}
          </ul>
        </Section>
      )
    }

    <Section id="skills" n={sectionNo.skills} title="Toolkit" teaser="What I reach for" i={10}>
      <dl class="skills">
        {
          skills.map((s) => (
            <div>
              <dt class="label">{s.group}</dt>
              <dd>{s.items.join(', ')}</dd>
            </div>
          ))
        }
      </dl>
    </Section>

    <section class="frame contact reveal" style="--i: 11" aria-labelledby="contact-title">
      <div class="margin label" aria-hidden="true">§ —</div>
      <div>
        <h2 id="contact-title">Hiring a senior Rails engineer?</h2>
        <p>
          Email me: <a href={`mailto:${profile.email}`}>{profile.email}</a>.
        </p>
        <p class="mono muted">{profile.utcOffset} · overlap {profile.overlap}</p>
      </div>
    </section>
  </main>
</Base>

<script>
  // One switch for readers who'd rather see everything at once.
  const toggleAll = document.querySelector<HTMLButtonElement>('.toggle-all');
  const chapters = () => [...document.querySelectorAll<HTMLDetailsElement>('main details')];
  const syncLabel = () => {
    if (toggleAll) toggleAll.textContent = chapters().every((d) => d.open) ? 'Collapse all' : 'Expand all';
  };
  toggleAll?.addEventListener('click', () => {
    const open = !chapters().every((d) => d.open);
    chapters().forEach((d) => (d.open = open));
    syncLabel();
  });
  chapters().forEach((d) => d.addEventListener('toggle', syncLabel));
  syncLabel();

  document.querySelectorAll<HTMLButtonElement>('button.copy').forEach((btn) => {
    const label = btn.querySelector<HTMLElement>('[data-label]')!;
    btn.addEventListener('click', async () => {
      const email = btn.dataset.email!;
      try {
        await navigator.clipboard.writeText(email);
        label.textContent = 'Copied ✓';
      } catch {
        location.href = `mailto:${email}`;
        return;
      }
      setTimeout(() => (label.textContent = 'Copy email'), 1800);
    });
  });
</script>

<style>
  .intro {
    margin-bottom: 3.5rem;
  }
  .top {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: 1rem;
    margin-bottom: 1.75rem;
  }
  .portrait {
    width: 64px;
    height: 64px;
    border-radius: 50%;
    object-fit: cover;
    filter: saturate(0.85) sepia(0.08);
  }
  .status {
    margin: 0;
    text-align: right;
  }
  h1 {
    margin: 0;
    font-size: clamp(2.5rem, 7vw, 3.5rem);
    line-height: 1;
    font-weight: 400;
    letter-spacing: -0.025em;
  }
  .role {
    margin: 0.85rem 0 1.25rem;
  }
  .statement {
    font-size: 1.375rem;
    line-height: 1.45;
    max-width: 34rem;
    margin-bottom: 1.5rem;
  }
  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1.25rem;
  }
  .actions a,
  .copy {
    color: var(--ink);
  }
  .copy {
    font: inherit;
    background: none;
    border: 0;
    padding: 0;
    cursor: pointer;
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-decoration-color: var(--rule);
    text-underline-offset: 0.2em;
  }
  .copy:hover {
    text-decoration-color: var(--accent);
  }

  .quotes > div:last-child {
    border-top: 1px solid var(--rule);
    padding: 1.75rem 0 1rem;
  }
  .quotes figure {
    margin: 0 0 1.75rem;
  }
  .quotes blockquote {
    margin: 0 0 0.5rem;
    font-size: 1.3rem;
    line-height: 1.45;
    font-style: italic;
    text-indent: -0.4em;
  }
  .quotes blockquote::before {
    content: '“';
  }
  .quotes blockquote::after {
    content: '”';
  }
  .quotes .sample {
    display: inline-block;
    margin-bottom: 0.4rem;
    padding: 0.1rem 0.4rem;
    color: var(--accent);
    border: 1px solid var(--accent);
    border-radius: 3px;
  }

  .toolbar > div:last-child {
    display: flex;
    justify-content: flex-end;
    margin-bottom: 0.4rem;
  }
  .toggle-all {
    font: inherit;
    font-family: var(--mono);
    font-size: 0.6875rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--muted);
    background: none;
    border: 0;
    padding: 0.25rem 0;
    cursor: pointer;
  }
  .toggle-all:hover {
    color: var(--accent);
  }
  .education {
    margin-top: 2rem;
    padding-top: 1rem;
    border-top: 1px dashed var(--rule);
  }
  .education p {
    margin: 0.3rem 0 0;
  }
  .education p .label {
    margin-left: 0.4rem;
  }

  .workflow-title {
    margin: 1.75rem 0 0.75rem;
    font-size: 0.6875rem;
    font-weight: 400;
  }
  .workflow {
    list-style: none;
    counter-reset: wf;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0;
    border-top: 1px dashed var(--rule);
  }
  .workflow li {
    counter-increment: wf;
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 0.1rem;
    padding: 0.7rem 0.75rem 0.7rem 2rem;
    border-bottom: 1px dashed var(--rule);
  }
  .workflow li:nth-child(odd) {
    border-right: 1px dashed var(--rule);
  }
  .workflow li::before {
    content: counter(wf, decimal-leading-zero);
    position: absolute;
    left: 0.25rem;
    top: 0.95rem;
    font-family: var(--mono);
    font-size: 0.65rem;
    color: var(--accent);
  }
  .workflow strong {
    font-weight: 500;
  }
  .workflow span {
    font-size: 0.95rem;
    line-height: 1.4;
    color: var(--ink-soft);
  }

  .lede {
    font-style: italic;
    margin-bottom: 0.5rem;
  }

  .numbers {
    list-style: none;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1.25rem 1.5rem;
    margin: 1rem 0 1.25rem;
    padding: 1rem 0;
    border-block: 1px dashed var(--rule);
  }
  .numbers li {
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
  }
  .value {
    font-size: 1.75rem;
    line-height: 1.1;
    font-weight: 400;
    font-variant-numeric: lining-nums;
  }


  h3 {
    margin: 0;
    font-size: 1.2rem;
    font-weight: 500;
  }
  .employer {
    margin: 0 0 1rem;
  }
  .employer a {
    text-decoration: none;
  }
  .job + .job {
    margin-top: 2rem;
  }
  .job header {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    flex-wrap: wrap;
    gap: 0.25rem 1rem;
  }
  .job header + p {
    margin: 0.3rem 0 0.75rem;
    font-style: italic;
  }
  .dash {
    list-style: none;
  }
  .dash li {
    position: relative;
    padding-left: 1.1rem;
  }
  .dash li + li {
    margin-top: 0.3rem;
  }
  .dash li::before {
    content: '–';
    position: absolute;
    left: 0;
    color: var(--muted);
  }
  .oss h3 {
    margin-bottom: 0.5rem;
  }
  .oss h3 .label {
    margin-left: 0.4rem;
  }
  .stack {
    margin: 1rem 0 0;
  }

  .posts {
    list-style: none;
  }
  .posts li {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 1rem;
    padding: 0.6rem 0;
    border-bottom: 1px dashed var(--rule);
  }

  .skills {
    margin: 0;
  }
  .skills div {
    display: grid;
    grid-template-columns: 8.5rem 1fr;
    gap: 1rem;
    padding: 0.55rem 0;
    border-bottom: 1px dashed var(--rule);
  }
  .skills div:last-child {
    border-bottom: 0;
  }
  .skills dt {
    padding-top: 0.3rem;
  }
  .skills dd {
    margin: 0;
  }


  .contact > div:last-child {
    border-top: 1px solid var(--ink);
    padding-top: 2rem;
    margin-top: 0;
  }
  .contact h2 {
    margin: 0 0 0.75rem;
    font-size: 1.75rem;
    font-weight: 400;
    font-style: italic;
    line-height: 1.2;
    letter-spacing: -0.015em;
  }
  .contact .mono {
    margin: 0;
  }

  @media (max-width: 30rem) {
    .numbers {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
    .workflow {
      grid-template-columns: minmax(0, 1fr);
    }
    .workflow li:nth-child(odd) {
      border-right: 0;
    }
    .skills div {
      grid-template-columns: 1fr;
      gap: 0.15rem;
    }
    .statement {
      font-size: 1.25rem;
    }
  }
</style>
