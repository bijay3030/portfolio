---
import { url } from '../../utils/url';
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { profile } from '../../data/site';

export async function getStaticPaths() {
  // Drafts get pages in dev so you can preview them; they are never built for production.
  const posts = await getCollection('writing', (p) => import.meta.env.DEV || !p.data.draft);
  return posts.map((post) => ({ params: { slug: post.id }, props: { post } }));
}

const { post } = Astro.props;
const { Content } = await render(post);
const date = post.data.date.toLocaleDateString('en-US', { day: 'numeric', month: 'long', year: 'numeric' });
---

<Base title={`${post.data.title} — ${profile.name}`} description={post.data.description}>
  <article class="frame">
    <div class="margin label"><a href={url('#writing')}>← Index</a></div>
    <div>
      <p class="mobile-back label"><a href={url('#writing')}>← {profile.name}</a></p>
      <header class="reveal" style="--i: 0">
        <p class="label">
          {date}{post.data.draft && ' · Draft'}{post.data.tags.length > 0 && ` · ${post.data.tags.join(', ')}`}
        </p>
        <h1>{post.data.title}</h1>
        <p class="dek">{post.data.description}</p>
      </header>
      <div class="prose reveal" style="--i: 1">
        <Content />
      </div>
    </div>
  </article>
</Base>

<style>
  .margin a,
  .mobile-back a {
    text-decoration: none;
  }
  .mobile-back {
    display: none;
  }
  header {
    margin-bottom: 2.5rem;
    padding-bottom: 1.5rem;
    border-bottom: 1px solid var(--rule);
  }
  h1 {
    margin: 0.75rem 0 0.75rem;
    font-size: clamp(2rem, 6vw, 2.75rem);
    line-height: 1.1;
    font-weight: 400;
    letter-spacing: -0.02em;
  }
  .dek {
    margin: 0;
    font-size: 1.25rem;
    font-style: italic;
    color: var(--ink-soft);
  }
  @media (max-width: 52rem) {
    .mobile-back {
      display: block;
      margin: 0 0 2rem;
    }
  }
</style>
