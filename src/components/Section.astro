---
// A numbered, collapsible chapter. The teaser says what's inside before anyone opens it.
interface Props {
  id: string;
  n: number;
  title: string;
  teaser?: string;
  open?: boolean;
  i?: number;
}

const { id, n, title, teaser, open = false, i = 0 } = Astro.props;
const num = String(n).padStart(2, '0');
---

<section class="frame reveal" style={`--i: ${i}`} aria-labelledby={`${id}-title`}>
  <div class="margin label" aria-hidden="true">§ {num}</div>
  <details id={id} open={open}>
    <summary>
      <span class="num label" aria-hidden="true">{num}</span>
      <h2 id={`${id}-title`}>{title}</h2>
      {teaser && <span class="teaser label">{teaser}</span>}
      <span class="sign" aria-hidden="true"></span>
    </summary>
    <div class="body">
      <slot />
    </div>
  </details>
</section>

<style>
  details {
    border-top: 1px solid var(--rule);
  }
  summary {
    list-style: none;
    display: flex;
    align-items: baseline;
    gap: 0.75rem;
    padding: 1.1rem 0;
    cursor: pointer;
    user-select: none;
  }
  summary::-webkit-details-marker {
    display: none;
  }
  h2 {
    margin: 0;
    font-size: 1.375rem;
    font-weight: 450;
    letter-spacing: -0.01em;
  }
  .num {
    display: none;
  }
  .teaser {
    margin-left: auto;
    text-align: right;
  }
  .sign {
    position: relative;
    flex: none;
    width: 0.7rem;
    height: 0.7rem;
    align-self: center;
    margin-left: 0.5rem;
  }
  .teaser + .sign {
    margin-left: 0.25rem;
  }
  h2 + .sign {
    margin-left: auto;
  }
  .sign::before,
  .sign::after {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    top: 50%;
    height: 1px;
    background: var(--ink);
    transition: transform 0.35s var(--ease);
  }
  .sign::after {
    transform: rotate(90deg);
  }
  details[open] .sign::after {
    transform: rotate(0deg);
  }
  summary:hover h2 {
    color: var(--accent);
  }
  .body {
    padding: 0.25rem 0 2.25rem;
  }

  /* Smooth open/close where the browser supports animating details content. */
  @media (prefers-reduced-motion: no-preference) {
    details::details-content {
      block-size: 0;
      overflow-y: clip;
      transition:
        block-size 0.45s var(--ease),
        content-visibility 0.45s allow-discrete;
    }
    details[open]::details-content {
      block-size: auto;
    }
  }

  @media (max-width: 52rem) {
    .num {
      display: inline;
      min-width: 1.5rem;
    }
  }
  @media (max-width: 30rem) {
    .teaser {
      display: none;
    }
    .sign,
    .teaser + .sign {
      margin-left: auto;
    }
  }
</style>
